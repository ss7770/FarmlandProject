<?xml version="1.0" encoding="utf-8"?>
<!-- 水位图标（2026-10-07 参照用户提供的 3D 球体参考图绘制）：
     蓝色水球 + 一大一小白水滴 + 两道白色波浪线。
     ⚠️ 不用 VectorDrawable 渐变（要 API 24，工程 minSdk 23），
        立体感用「深色边球 + 上移浅色主球」两层伪造。整颗球自带底色，
        使用处不要再垫 bg_badge_* 白圆徽章，也不要加 tint。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="38dp"
    android:height="38dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- 球底（深蓝，露出下缘作暗边） -->
    <path
        android:fillColor="#2E7FC7"
        android:pathData="M12,1a11,11 0 1,0 0,22a11,11 0 1,0 0,-22z" />
    <!-- 主球（浅一档，整体上移 0.8，底部留出深色暗边 = 球体感） -->
    <path
        android:fillColor="#3E97E4"
        android:pathData="M12,1.9a10.1,10.1 0 1,0 0,20.2a10.1,10.1 0 1,0 0,-20.2z" />

    <!-- 大水滴（左） -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M10.7,5.5 C11.8,7.1 12.6,8.2 12.6,9.2 C12.6,10.3 11.8,11.1 10.7,11.1 C9.6,11.1 8.8,10.3 8.8,9.2 C8.8,8.2 9.6,7.1 10.7,5.5 Z" />
    <!-- 小水滴（右） -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M15.4,6.7 C16.1,7.8 16.6,8.5 16.6,9.1 C16.6,9.8 16.1,10.3 15.4,10.3 C14.7,10.3 14.2,9.8 14.2,9.1 C14.2,8.5 14.7,7.8 15.4,6.7 Z" />

    <!-- 两道白色波浪线（圆头描边） -->
    <path
        android:pathData="M5.6,13.4 C6.8,12.5 8,12.5 9.2,13.2 C10.4,13.9 11.6,13.9 12.8,13.2 C14,12.5 15.2,12.5 16.4,13.2 C17.1,13.6 17.7,13.6 18.3,13.3"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.1"
        android:strokeLineCap="round" />
    <path
        android:pathData="M5.6,16.5 C6.8,15.6 8,15.6 9.2,16.3 C10.4,17 11.6,17 12.8,16.3 C14,15.6 15.2,15.6 16.4,16.3 C17.1,16.7 17.7,16.7 18.3,16.4"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.1"
        android:strokeLineCap="round" />
</vector>
