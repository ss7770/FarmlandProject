<?xml version="1.0" encoding="utf-8"?>
<!-- 土壤湿度图标（2026-10-07 参照用户提供的 3D 球体参考图绘制）：
     棕色土壤球 + 白色地层波浪线 + 三颗白色孔隙点 + 顶部三叶绿芽。
     ⚠️ 不用 VectorDrawable 渐变（要 API 24，工程 minSdk 23），
        立体感用「深色边球 + 上移浅色主球」两层伪造。整颗球自带底色，
        使用处不要再垫 bg_badge_* 白圆徽章，也不要加 tint。 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="38dp"
    android:height="38dp"
    android:viewportWidth="24"
    android:viewportHeight="24">

    <!-- 球底（深棕，露出下缘作暗边） -->
    <path
        android:fillColor="#7B4E2E"
        android:pathData="M12,1a11,11 0 1,0 0,22a11,11 0 1,0 0,-22z" />
    <!-- 主球（浅一档，整体上移 0.8，底部留出深色暗边 = 球体感） -->
    <path
        android:fillColor="#8D5F3A"
        android:pathData="M12,1.9a10.1,10.1 0 1,0 0,20.2a10.1,10.1 0 1,0 0,-20.2z" />

    <!-- 顶部三叶绿芽：中叶亮绿，两侧叶深一档 -->
    <path
        android:fillColor="#5FB44A"
        android:pathData="M11.6,12.9 C9.7,12.8 8.1,11.6 7.5,9.8 C7.2,8.8 7.2,8.2 7.3,7.7 C7.8,7.6 8.4,7.6 9.3,8 C11.1,8.7 12,10.7 11.6,12.9 Z" />
    <path
        android:fillColor="#5FB44A"
        android:pathData="M12.4,12.9 C14.3,12.8 15.9,11.6 16.5,9.8 C16.8,8.8 16.8,8.2 16.7,7.7 C16.2,7.6 15.6,7.6 14.7,8 C12.9,8.7 12,10.7 12.4,12.9 Z" />
    <path
        android:fillColor="#7FCB68"
        android:pathData="M12,13.1 C10.4,11.9 9.9,9.6 10.7,7.6 C11.1,6.6 11.6,6.1 12,5.7 C12.4,6.1 12.9,6.6 13.3,7.6 C14.1,9.6 13.6,11.9 12,13.1 Z" />

    <!-- 白色地层波浪线（圆头粗描边） -->
    <path
        android:pathData="M6.1,14.7 C7.3,13.8 8.5,13.8 9.7,14.5 C10.9,15.2 12.1,15.2 13.3,14.5 C14.5,13.8 15.7,13.8 16.9,14.5 C17.5,14.8 17.9,14.8 18.4,14.6"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2.3"
        android:strokeLineCap="round" />

    <!-- 三颗白色孔隙点（中間那颗略低） -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M7.65,17.7a1.25,1.25 0 1,0 2.5,0a1.25,1.25 0 1,0 -2.5,0z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M10.95,18.7a1.05,1.05 0 1,0 2.1,0a1.05,1.05 0 1,0 -2.1,0z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M13.85,17.7a1.25,1.25 0 1,0 2.5,0a1.25,1.25 0 1,0 -2.5,0z" />
</vector>
