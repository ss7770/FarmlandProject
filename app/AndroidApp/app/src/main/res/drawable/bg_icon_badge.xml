<?xml version="1.0" encoding="utf-8"?>
<!-- 传感器图标徽章：绿色渐变圆角方块（参考图风格）。
     用法：直接作为 ImageView 的 background，图标本身 tint 白色，
     布局里 ImageView 尺寸=徽章尺寸，padding 决定 glyph 大小。 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="@color/colorBadgeStart"
        android:endColor="@color/colorBadgeEnd"
        android:type="linear" />
    <corners android:radius="14dp" />
</shape>
